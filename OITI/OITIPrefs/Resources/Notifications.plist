<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>items</key>
    <array>
      <dict>
        <key>cell</key>
        <string>PSGroupCell</string>
        <key>label</key>
        <string>Island Notifications</string>
        <key>footerText</key>
        <string>Shows notifications in the Island. Needs Enable Dynamic Island.</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSSwitchCell</string>
        <key>default</key>
        <false/>
        <key>defaults</key>
        <string>com.wilburt.oiti.prefs</string>
        <key>key</key>
        <string>islandNotificationsEnabled</string>
        <key>label</key>
        <string>Show Notifications in the Island</string>
        <key>PostNotification</key>
        <string>com.wilburt.oiti/PrefsChanged</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSSwitchCell</string>
        <key>default</key>
        <false/>
        <key>defaults</key>
        <string>com.wilburt.oiti.prefs</string>
        <key>key</key>
        <string>islandNotificationsHideBanner</string>
        <key>label</key>
        <string>Hide the Stock Banner</string>
        <key>PostNotification</key>
        <string>com.wilburt.oiti/PrefsChanged</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSGroupCell</string>
        <key>label</key>
        <string>Experimental Notification Stack</string>
        <key>footerText</key>
        <string>Shows up to four notifications: the newest in the Island, older ones as small cards below it. Tap a card to open it, swipe up to dismiss.</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSSwitchCell</string>
        <key>default</key>
        <true/>
        <key>defaults</key>
        <string>com.wilburt.oiti.prefs</string>
        <key>key</key>
        <string>islandNotificationStackEnabled</string>
        <key>label</key>
        <string>Stack Multiple Notifications (Experimental)</string>
        <key>PostNotification</key>
        <string>com.wilburt.oiti/PrefsChanged</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSGroupCell</string>
        <key>label</key>
        <string>Island Notification Style</string>
        <key>footerText</key>
        <string>Expanded shows the icon, title and message; Wide and Compact are smaller. Applies to the next notification.</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSLinkListCell</string>
        <key>detail</key>
        <string>PSListItemsController</string>
        <key>defaults</key>
        <string>com.wilburt.oiti.prefs</string>
        <key>key</key>
        <string>IslandNotificationsStyle</string>
        <key>default</key>
        <integer>2</integer>
        <key>label</key>
        <string>Style</string>
        <key>validTitles</key>
        <array>
          <string>Compact</string>
          <string>Wide</string>
          <string>Expanded</string>
        </array>
        <key>validValues</key>
        <array>
          <integer>0</integer>
          <integer>1</integer>
          <integer>2</integer>
        </array>
        <key>PostNotification</key>
        <string>com.wilburt.oiti/PrefsChanged</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSGroupCell</string>
        <key>label</key>
        <string>Tapping a Notification</string>
        <key>footerText</key>
        <string>Removes a notification from the Island right after you tap it.</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSSwitchCell</string>
        <key>default</key>
        <false/>
        <key>defaults</key>
        <string>com.wilburt.oiti.prefs</string>
        <key>key</key>
        <string>NotificationTapDismisses</string>
        <key>label</key>
        <string>Dismiss When Tapped</string>
        <key>PostNotification</key>
        <string>com.wilburt.oiti/PrefsChanged</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSGroupCell</string>
        <key>label</key>
        <string>Haptics</string>
        <key>footerText</key>
        <string>A light tap when a notification arrives.</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSSwitchCell</string>
        <key>default</key>
        <false/>
        <key>defaults</key>
        <string>com.wilburt.oiti.prefs</string>
        <key>key</key>
        <string>NotificationHaptic</string>
        <key>label</key>
        <string>Notification Haptic</string>
        <key>PostNotification</key>
        <string>com.wilburt.oiti/PrefsChanged</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSGroupCell</string>
        <key>label</key>
        <string>Island Notification Duration</string>
        <key>footerText</key>
        <string>How many seconds each notification stays in the Island.</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSSliderCell</string>
        <key>default</key>
        <real>4.0</real>
        <key>defaults</key>
        <string>com.wilburt.oiti.prefs</string>
        <key>key</key>
        <string>IslandNotificationsDuration</string>
        <key>min</key>
        <real>2.0</real>
        <key>max</key>
        <real>10.0</real>
        <key>showValue</key>
        <true/>
        <key>PostNotification</key>
        <string>com.wilburt.oiti/PrefsChanged</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSGroupCell</string>
        <key>label</key>
        <string>Island Notification Message Lines</string>
        <key>footerText</key>
        <string>How many message lines show before the text is cut off.</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSSliderCell</string>
        <key>default</key>
        <real>2.0</real>
        <key>defaults</key>
        <string>com.wilburt.oiti.prefs</string>
        <key>key</key>
        <string>IslandNotificationsMessageLines</string>
        <key>min</key>
        <real>1.0</real>
        <key>max</key>
        <real>4.0</real>
        <key>showValue</key>
        <true/>
        <key>PostNotification</key>
        <string>com.wilburt.oiti/PrefsChanged</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSGroupCell</string>
        <key>label</key>
        <string>Island Notification Roundness</string>
        <key>footerText</key>
        <string>Extra corner radius for notifications. 0 is stock.</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSSliderCell</string>
        <key>default</key>
        <real>0.0</real>
        <key>defaults</key>
        <string>com.wilburt.oiti.prefs</string>
        <key>key</key>
        <string>IslandNotificationsCornerExtra</string>
        <key>min</key>
        <real>-4.0</real>
        <key>max</key>
        <real>8.0</real>
        <key>showValue</key>
        <true/>
        <key>PostNotification</key>
        <string>com.wilburt.oiti/PrefsChanged</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSGroupCell</string>
        <key>label</key>
        <string>Custom Notification Positioning</string>
        <key>footerText</key>
        <string>Moves banners to the X and Y you enter, in points. Applies when you leave a field or tap Save.</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSSwitchCell</string>
        <key>default</key>
        <false/>
        <key>defaults</key>
        <string>com.wilburt.oiti.prefs</string>
        <key>key</key>
        <string>notEnabled</string>
        <key>label</key>
        <string>Use Custom Notification Position</string>
        <key>PostNotification</key>
        <string>com.wilburt.oiti/PrefsChanged</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSEditTextCell</string>
        <key>label</key>
        <string>X Position:</string>
        <key>prompt</key>
        <string>Enter X Position</string>
        <key>bestGuess</key>
        <string>0</string>
        <key>placeholder</key>
        <string>0</string>
        <key>isNumeric</key>
        <false/>
        <key>PostNotification</key>
        <string>com.wilburt.oiti/PrefsChanged</string>
        <key>defaults</key>
        <string>com.wilburt.oiti.prefs</string>
        <key>key</key>
        <string>xNot</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSEditTextCell</string>
        <key>label</key>
        <string>Y Position:</string>
        <key>prompt</key>
        <string>Enter Y Position</string>
        <key>bestGuess</key>
        <string>40</string>
        <key>placeholder</key>
        <string>40</string>
        <key>isNumeric</key>
        <false/>
        <key>PostNotification</key>
        <string>com.wilburt.oiti/PrefsChanged</string>
        <key>defaults</key>
        <string>com.wilburt.oiti.prefs</string>
        <key>key</key>
        <string>yNot</string>
      </dict>
      <dict>
        <key>action</key>
        <string>savePos:</string>
        <key>cell</key>
        <string>PSButtonCell</string>
        <key>label</key>
        <string>Save</string>
        <key>defaults</key>
        <string>com.wilburt.oiti.prefs</string>
      </dict>
    </array>
    <key>title</key>
    <string>Notifications</string>
  </dict>
</plist>
