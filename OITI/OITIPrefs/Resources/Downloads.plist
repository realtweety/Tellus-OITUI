<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>title</key>
    <string>Download Progress</string>
    <key>items</key>
    <array>
      <dict>
        <key>cell</key>
        <string>PSGroupCell</string>
        <key>label</key>
        <string>Download Progress (Experimental)</string>
        <key>footerText</key>
        <string>Shows downloads in the Island as a progress bar. Off by default.</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSSwitchCell</string>
        <key>default</key>
        <false/>
        <key>defaults</key>
        <string>com.wilburt.oiti.prefs</string>
        <key>key</key>
        <string>DownloadProgressEnabled</string>
        <key>label</key>
        <string>Show Download Progress</string>
        <key>PostNotification</key>
        <string>com.wilburt.oiti/PrefsChanged</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSGroupCell</string>
        <key>label</key>
        <string>App Store Downloads (Experimental)</string>
        <key>footerText</key>
        <string>Shows App Store downloads with the percentage and the time left. Needs Show Download Progress.</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSSwitchCell</string>
        <key>default</key>
        <false/>
        <key>defaults</key>
        <string>com.wilburt.oiti.prefs</string>
        <key>key</key>
        <string>DownloadAppStoreEnabled</string>
        <key>label</key>
        <string>Show App Store Downloads</string>
        <key>PostNotification</key>
        <string>com.wilburt.oiti/PrefsChanged</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSGroupCell</string>
        <key>label</key>
        <string>Look</string>
        <key>footerText</key>
        <string>Minimal is a small pill over the Island. Detailed is the system's expanded Island.</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSLinkListCell</string>
        <key>detail</key>
        <string>PSListItemsController</string>
        <key>defaults</key>
        <string>com.wilburt.oiti.prefs</string>
        <key>key</key>
        <string>DownloadProgressStyle</string>
        <key>default</key>
        <integer>0</integer>
        <key>label</key>
        <string>Style</string>
        <key>validTitles</key>
        <array>
          <string>Minimal</string>
          <string>Detailed</string>
        </array>
        <key>validValues</key>
        <array>
          <integer>0</integer>
          <integer>1</integer>
        </array>
        <key>PostNotification</key>
        <string>com.wilburt.oiti/PrefsChanged</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSGroupCell</string>
        <key>label</key>
        <string>Minimal Size</string>
        <key>footerText</key>
        <string>Adjusts the Minimal pill. Start a test download to see the changes.</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSSliderCell</string>
        <key>label</key>
        <string>Width</string>
        <key>default</key>
        <real>296.0</real>
        <key>defaults</key>
        <string>com.wilburt.oiti.prefs</string>
        <key>key</key>
        <string>DownloadPillWidth</string>
        <key>min</key>
        <real>200.0</real>
        <key>max</key>
        <real>380.0</real>
        <key>showValue</key>
        <true/>
        <key>valueFormat</key>
        <string>%.0f pt</string>
        <key>PostNotification</key>
        <string>com.wilburt.oiti/PrefsChanged</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSSliderCell</string>
        <key>label</key>
        <string>Bottom padding</string>
        <key>default</key>
        <real>10.0</real>
        <key>defaults</key>
        <string>com.wilburt.oiti.prefs</string>
        <key>key</key>
        <string>DownloadPillBottomPadding</string>
        <key>min</key>
        <real>0.0</real>
        <key>max</key>
        <real>40.0</real>
        <key>showValue</key>
        <true/>
        <key>valueFormat</key>
        <string>%.0f pt</string>
        <key>PostNotification</key>
        <string>com.wilburt.oiti/PrefsChanged</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSSliderCell</string>
        <key>label</key>
        <string>Move up or down</string>
        <key>default</key>
        <real>0.0</real>
        <key>defaults</key>
        <string>com.wilburt.oiti.prefs</string>
        <key>key</key>
        <string>DownloadPillNudgeY</string>
        <key>min</key>
        <real>-30.0</real>
        <key>max</key>
        <real>30.0</real>
        <key>showValue</key>
        <true/>
        <key>valueFormat</key>
        <string>%.0f pt</string>
        <key>PostNotification</key>
        <string>com.wilburt.oiti/PrefsChanged</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSGroupCell</string>
        <key>label</key>
        <string>Return to Idle</string>
        <key>footerText</key>
        <string>Hides the bar when a limit is reached; the download carries on. Never means no limit. The size limit only applies to the test download.</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSSliderCell</string>
        <key>label</key>
        <string>After this much is downloaded</string>
        <key>default</key>
        <real>0.0</real>
        <key>defaults</key>
        <string>com.wilburt.oiti.prefs</string>
        <key>key</key>
        <string>DownloadIdleAfterMB</string>
        <key>min</key>
        <real>0.0</real>
        <key>max</key>
        <real>5000.0</real>
        <key>showValue</key>
        <true/>
        <key>valueFormat</key>
        <string>%.0f MB</string>
        <key>zeroText</key>
        <string>Never</string>
        <key>PostNotification</key>
        <string>com.wilburt.oiti/PrefsChanged</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSSliderCell</string>
        <key>label</key>
        <string>After this percentage is reached</string>
        <key>default</key>
        <real>0.0</real>
        <key>defaults</key>
        <string>com.wilburt.oiti.prefs</string>
        <key>key</key>
        <string>DownloadIdleAfterPercent</string>
        <key>min</key>
        <real>0.0</real>
        <key>max</key>
        <real>99.0</real>
        <key>showValue</key>
        <true/>
        <key>valueFormat</key>
        <string>%.0f%%</string>
        <key>zeroText</key>
        <string>Never</string>
        <key>PostNotification</key>
        <string>com.wilburt.oiti/PrefsChanged</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSSliderCell</string>
        <key>label</key>
        <string>After this long on screen</string>
        <key>default</key>
        <real>0.0</real>
        <key>defaults</key>
        <string>com.wilburt.oiti.prefs</string>
        <key>key</key>
        <string>DownloadIdleAfterSeconds</string>
        <key>min</key>
        <real>0.0</real>
        <key>max</key>
        <real>900.0</real>
        <key>showValue</key>
        <true/>
        <key>valueFormat</key>
        <string>%.0f s</string>
        <key>zeroText</key>
        <string>Never</string>
        <key>PostNotification</key>
        <string>com.wilburt.oiti/PrefsChanged</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSGroupCell</string>
        <key>label</key>
        <string>Test Download</string>
        <key>footerText</key>
        <string>A simulated download for trying the look and the limits. Needs Show Download Progress.</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSSliderCell</string>
        <key>label</key>
        <string>Test download size</string>
        <key>default</key>
        <real>800.0</real>
        <key>defaults</key>
        <string>com.wilburt.oiti.prefs</string>
        <key>key</key>
        <string>DownloadTestSizeMB</string>
        <key>min</key>
        <real>50.0</real>
        <key>max</key>
        <real>5000.0</real>
        <key>showValue</key>
        <true/>
        <key>valueFormat</key>
        <string>%.0f MB</string>
        <key>PostNotification</key>
        <string>com.wilburt.oiti/PrefsChanged</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSButtonCell</string>
        <key>label</key>
        <string>Start Test Download</string>
        <key>action</key>
        <string>startTestDownload</string>
        <key>defaults</key>
        <string>com.wilburt.oiti.prefs</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSButtonCell</string>
        <key>label</key>
        <string>Stop Test Download</string>
        <key>action</key>
        <string>stopTestDownload</string>
        <key>defaults</key>
        <string>com.wilburt.oiti.prefs</string>
      </dict>
    </array>
  </dict>
</plist>
