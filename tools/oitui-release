#!/usr/bin/env python3
"""OITUI Release: the release steps of COMMANDS.md sections 43 and 44 as one command.

  oitui-release status                      read-only overview of the repository and the releases
  oitui-release verify <tag | folder>       check a release's files against its signed SHA256SUMS
  oitui-release candidate <version>         build, assemble, sign and publish a release candidate (a pre-release)

<version> is the number of the OITUI release (for example 0.4.2); the candidate is tagged v<version>-rc.<n>.

Safety rules the tool keeps, whatever the options:
  - It never sees your key passphrase: openssl asks you for it on the terminal.
  - It signs only after it has shown you the files and the hashes and you have said yes, and it checks the new signature
    against the public keys built into TellusApp/Helper/tellus-helper.c before it goes on.
  - Every command that changes something (workflow run, tag, push, release) is logged, and with --dry-run it is only printed.
  - It never merges, never force-pushes and never touches the main branch.

Needs: python3, git, gh (logged in), openssl 3. Standard library only. Logs go to ~/.local/state/oitui-release/.
"""

import argparse
import datetime
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

REPO_DIR = Path(os.environ.get("OITUI_REPO_DIR") or Path(__file__).resolve().parent.parent)
WORK_BRANCH = "experiments"
BUILD_WORKFLOW = "build-oiti.yml"
RELEASE_WORKFLOW = "release-oiti.yml"
ARCH = "iphoneos-arm64"
HELPER_SOURCE = "TellusApp/Helper/tellus-helper.c"
PBXPROJ = "TellusApp/TellusApp.xcodeproj/project.pbxproj"
# (short name, package id, control file); the order is the install order of Update All.
PACKAGES = [
    ("oitcore", "com.wilburt.oitcore", "OITCore/control"),
    ("oiti", "com.wilburt.oiti", "OITI/control"),
    ("tellus", "com.wilburt.tellus", "TellusApp/layout/DEBIAN/control"),
]
KEY_LABELS = {"1": "primary", "2": "backup"}
SPKI_PREFIX = bytes.fromhex("302a300506032b6570032100")   # DER wrapper of a raw 32-byte Ed25519 public key
POLL_SECONDS = float(os.environ.get("OITUI_POLL_SECONDS", "3"))

DRY_RUN = False
LOG_FILE = None


class Abort(Exception):
    """A reason to stop. Nothing has been changed that the message does not say."""


# ---------------------------------------------------------------- output, logging, commands

def say(message=""):
    print(message, flush=True)


def log(message):
    if LOG_FILE is not None:
        with open(LOG_FILE, "a") as handle:
            handle.write(message.rstrip("\n") + "\n")


def start_log(name):
    global LOG_FILE
    base = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local" / "state") / "oitui-release"
    base.mkdir(parents=True, exist_ok=True)
    LOG_FILE = base / (datetime.datetime.now().strftime("%Y%m%d-%H%M%S") + "-" + name + ".log")
    log("oitui-release " + name + " in " + str(REPO_DIR))


def run(command, check=True, mutating=False, interactive=False, cwd=None):
    """Runs a command in the repository. `mutating` commands only print under --dry-run."""
    text = shlex.join(command)
    if mutating and DRY_RUN:
        say("[dry-run] would run: " + text)
        log("DRY-RUN " + text)
        return subprocess.CompletedProcess(command, 0, "", "")
    log("$ " + text)
    try:
        result = subprocess.run(command, cwd=cwd or REPO_DIR, text=True,
                                capture_output=not interactive)
    except FileNotFoundError:
        raise Abort("`" + command[0] + "` is not installed or not on the PATH")
    log("  exit " + str(result.returncode))
    if check and result.returncode != 0:
        detail = ((result.stderr or "") + (result.stdout or "")).strip()
        raise Abort("`" + text + "` failed (exit " + str(result.returncode) + ")" + (": " + detail if detail else ""))
    return result


def gh_json(arguments):
    return json.loads(run(["gh"] + arguments).stdout or "null")


def confirm(question):
    try:
        answer = input(question + " [y/N] ").strip().lower()
    except EOFError:
        answer = ""
    if answer != "y":
        raise Abort("stopped: you did not answer y")


# ---------------------------------------------------------------- versions and names

def parse_version(text):
    if not re.fullmatch(r"\d+(\.\d+)*", text):
        raise Abort("version '" + text + "' is not a plain dotted number; this tool does not handle `~`, `+` or letters")
    return tuple(int(part) for part in text.split("."))


def read_control(path):
    fields = {}
    for line in Path(path).read_text().splitlines():
        if ":" in line and not line.startswith((" ", "\t")):
            key, value = line.split(":", 1)
            fields[key.strip()] = value.strip()
    return fields


def deb_name(package_id, version):
    return package_id + "_" + version + "_" + ARCH + ".deb"


def parse_deb_name(name):
    match = re.fullmatch(r"(com\.wilburt\.[a-z]+)_([^_]+)_" + re.escape(ARCH) + r"\.deb", name)
    return (match.group(1), match.group(2)) if match else None


def local_versions():
    """The package versions in the working tree, with the consistency checks the release workflow also makes."""
    versions = {}
    for key, package_id, path in PACKAGES:
        fields = read_control(REPO_DIR / path)
        if fields.get("Package") != package_id:
            raise Abort(path + " is not the control file of " + package_id)
        versions[key] = fields["Version"]
        parse_version(fields["Version"])
    marketing = set(re.findall(r"MARKETING_VERSION = ([^;]+);", (REPO_DIR / PBXPROJ).read_text()))
    if marketing != {versions["tellus"]}:
        raise Abort("Tellus: control says " + versions["tellus"] + " but the Xcode project says " + ", ".join(sorted(marketing)))
    depends = read_control(REPO_DIR / PACKAGES[2][2]).get("Depends", "")
    needed = re.search(r"com\.wilburt\.oiti \(>= ([0-9.]+)\)", depends)
    if needed and parse_version(versions["oiti"]) < parse_version(needed.group(1)):
        raise Abort("Tellus needs Insula >= " + needed.group(1) + " but Insula is " + versions["oiti"])
    return versions


def sha256_file(path):
    digest = hashlib.sha256()
    with open(path, "rb") as handle:
        for block in iter(lambda: handle.read(1 << 20), b""):
            digest.update(block)
    return digest.hexdigest()


def parse_manifest(data):
    """{file name: hash} from SHA256SUMS bytes ('<64 hex>  name' or '<64 hex> *name'); a name listed twice with two hashes is an error."""
    entries = {}
    for line in data.decode("utf-8").splitlines():
        match = re.fullmatch(r"([0-9a-f]{64}) [ *](.+)", line)
        if not match:
            continue
        if entries.get(match.group(2), match.group(1)) != match.group(1):
            raise Abort("SHA256SUMS lists " + match.group(2) + " twice with different hashes")
        entries[match.group(2)] = match.group(1)
    return entries


# ---------------------------------------------------------------- signature checks

def trusted_keys():
    """{label: 32-byte key} from the TELLUS_TRUSTED_KEY_n constants of the helper source: the keys Tellus really trusts."""
    source = (REPO_DIR / HELPER_SOURCE).read_text()
    found = {}
    for number, hexkey in re.findall(r'#define TELLUS_TRUSTED_KEY_(\d)\s+"([0-9a-f]{64})"', source):
        found[KEY_LABELS.get(number, "key " + number)] = bytes.fromhex(hexkey)
    if not found:
        raise Abort("no TELLUS_TRUSTED_KEY constants found in " + HELPER_SOURCE)
    return found


def matching_trusted_key(manifest_path, signature_path):
    """The label of the built-in key whose signature this is, or None."""
    for label, key in trusted_keys().items():
        with tempfile.TemporaryDirectory() as scratch:
            der = Path(scratch) / "key.der"
            der.write_bytes(SPKI_PREFIX + key)
            result = run(["openssl", "pkeyutl", "-verify", "-rawin", "-pubin", "-keyform", "DER", "-inkey", str(der),
                          "-in", str(manifest_path), "-sigfile", str(signature_path)], check=False)
            if result.returncode == 0:
                return label
    return None


def check_release_folder(folder):
    """Checks the files of one release in `folder`. Returns (problems, signed)."""
    folder = Path(folder)
    problems = []
    manifest_path = folder / "SHA256SUMS"
    signature_path = folder / "SHA256SUMS.sig"
    debs = sorted(path.name for path in folder.glob("*.deb"))
    if not debs:
        problems.append("no .deb files in the release")
    if not manifest_path.exists():
        return problems + ["SHA256SUMS is missing"], False
    entries = parse_manifest(manifest_path.read_bytes())
    for name in debs:
        if "~" in name:
            problems.append(name + ": a `~` in the name (GitHub rewrites it)")
        if name not in entries:
            problems.append(name + ": not listed in SHA256SUMS")
        elif entries[name] != sha256_file(folder / name):
            problems.append(name + ": does not match its SHA256SUMS entry")
        else:
            say("ok   " + name + " matches SHA256SUMS")
    for name in entries:
        if name not in debs:
            problems.append("SHA256SUMS lists " + name + ", which is not in the release")
    if not signature_path.exists():
        say("NOTE this release has no SHA256SUMS.sig: Tellus will not install it")
        return problems, False
    if signature_path.stat().st_size != 64:
        problems.append("SHA256SUMS.sig is " + str(signature_path.stat().st_size) + " bytes, not 64")
        return problems, True
    label = matching_trusted_key(manifest_path, signature_path)
    if label is None:
        problems.append("SHA256SUMS.sig is not a valid signature by a key built into the helper")
    else:
        say("ok   SHA256SUMS.sig is a valid signature by the " + label + " key")
    return problems, True


# ---------------------------------------------------------------- repository and CI checks

def git(*arguments, check=True, mutating=False):
    return run(["git"] + list(arguments), check=check, mutating=mutating)


def preflight():
    """The state the repository must be in before a candidate is built. Returns the full HEAD hash."""
    branch = git("rev-parse", "--abbrev-ref", "HEAD").stdout.strip()
    if branch != WORK_BRANCH:
        raise Abort("you are on '" + branch + "', not '" + WORK_BRANCH + "' (git switch " + WORK_BRANCH + ")")
    if git("status", "--porcelain").stdout.strip():
        raise Abort("the working tree has uncommitted changes (git status --short)")
    git("fetch", "--quiet", "--tags", "origin")
    head = git("rev-parse", "HEAD").stdout.strip()
    remote = git("rev-parse", "origin/" + WORK_BRANCH, check=False).stdout.strip()
    if head != remote:
        raise Abort("HEAD (" + head[:7] + ") is not what origin/" + WORK_BRANCH + " has (" + (remote[:7] or "nothing") + "): push or pull first")
    runs = gh_json(["run", "list", "--workflow", BUILD_WORKFLOW, "--branch", WORK_BRANCH, "--limit", "20",
                    "--json", "databaseId,headSha,status,conclusion"])
    mine = [item for item in runs if item["headSha"] == head]
    if not mine:
        raise Abort("no CI build of " + head[:7] + " yet (push it and wait for " + BUILD_WORKFLOW + ")")
    if not any(item["status"] == "completed" and item["conclusion"] == "success" for item in mine):
        raise Abort("the CI build of " + head[:7] + " has not succeeded (status " + mine[0]["status"] + ", " + str(mine[0]["conclusion"]) + ")")
    say("ok   on " + WORK_BRANCH + ", clean, pushed, and CI is green for " + head[:7])
    return head


def latest_stable_tag():
    releases = gh_json(["release", "list", "--exclude-pre-releases", "--limit", "1", "--json", "tagName"])
    return releases[0]["tagName"] if releases else None


def release_versions(tag):
    """{package id: version} of the .deb files attached to a release."""
    assets = gh_json(["release", "view", tag, "--json", "assets"])["assets"]
    found = {}
    for asset in assets:
        parsed = parse_deb_name(asset["name"])
        if parsed:
            found[parsed[0]] = parsed[1]
    return found


# ---------------------------------------------------------------- status

def command_status(arguments):
    start_log("status")
    say("OITUI repository: " + str(REPO_DIR))
    branch = git("rev-parse", "--abbrev-ref", "HEAD").stdout.strip()
    dirty = bool(git("status", "--porcelain").stdout.strip())
    head = git("rev-parse", "HEAD").stdout.strip()
    say("branch " + branch + ", HEAD " + head[:7] + (", UNCOMMITTED CHANGES" if dirty else ", clean"))
    git("fetch", "--quiet", "--tags", "origin", check=False)
    remote = git("rev-parse", "origin/" + WORK_BRANCH, check=False).stdout.strip()
    say("origin/" + WORK_BRANCH + (" matches HEAD" if remote == head else " is " + (remote[:7] or "missing") + " (HEAD is not pushed or is behind)"))
    runs = gh_json(["run", "list", "--workflow", BUILD_WORKFLOW, "--branch", WORK_BRANCH, "--limit", "20",
                    "--json", "headSha,status,conclusion"]) or []
    mine = [item for item in runs if item["headSha"] == head]
    say("CI build of HEAD: " + ((mine[0]["status"] + ", " + str(mine[0]["conclusion"])) if mine else "none found"))
    stable = latest_stable_tag()
    say("latest stable release: " + str(stable))
    local = local_versions()
    released = release_versions(stable) if stable else {}
    for key, package_id, _ in PACKAGES:
        old = released.get(package_id)
        state = "new" if old is None else ("unchanged" if old == local[key] else "CHANGED from " + old)
        say("  " + package_id + " " + local[key] + "  (" + state + ")")
    tags = git("tag", "-l", "v*-rc.*").stdout.split()
    say("candidate tags: " + (", ".join(sorted(tags)) if tags else "none"))
    return 0


# ---------------------------------------------------------------- verify

def command_verify(arguments):
    start_log("verify")
    target = arguments.target
    if Path(target).is_dir():
        folder = Path(target)
        problems, signed = check_release_folder(folder)
    else:
        with tempfile.TemporaryDirectory() as scratch:
            run(["gh", "release", "download", target, "-D", scratch])
            problems, signed = check_release_folder(scratch)
    for problem in problems:
        say("FAIL " + problem)
    if not problems and signed:
        say("verdict: signed, complete and consistent")
        return 0
    if not problems:
        say("verdict: consistent, but UNSIGNED")
    return 1


# ---------------------------------------------------------------- candidate

def find_release_run(head, run_id):
    """A successful release-workflow run for HEAD that was started by hand (or the one named with --run)."""
    fields = "databaseId,headSha,status,conclusion,event,createdAt"
    runs = gh_json(["run", "list", "--workflow", RELEASE_WORKFLOW, "--branch", WORK_BRANCH, "--limit", "20", "--json", fields]) or []
    if run_id:
        chosen = [item for item in runs if str(item["databaseId"]) == str(run_id)]
        if not chosen:
            raise Abort("run " + str(run_id) + " is not a recent " + RELEASE_WORKFLOW + " run on " + WORK_BRANCH)
        if chosen[0]["headSha"] != head:
            raise Abort("run " + str(run_id) + " built " + chosen[0]["headSha"][:7] + ", not HEAD " + head[:7])
        return chosen[0]
    for item in runs:
        if item["headSha"] == head and item["event"] == "workflow_dispatch" and item["status"] == "completed" and item["conclusion"] == "success":
            say("ok   using the existing release build of " + head[:7] + " (run " + str(item["databaseId"]) + ")")
            return item
    return None


def trigger_release_run(head):
    started = datetime.datetime.now(datetime.timezone.utc) - datetime.timedelta(seconds=10)
    run(["gh", "workflow", "run", RELEASE_WORKFLOW, "--ref", WORK_BRANCH], mutating=True)
    if DRY_RUN:
        return None
    fields = "databaseId,headSha,status,conclusion,event,createdAt"
    for _ in range(40):
        time.sleep(POLL_SECONDS)
        for item in gh_json(["run", "list", "--workflow", RELEASE_WORKFLOW, "--branch", WORK_BRANCH, "--limit", "10", "--json", fields]) or []:
            created = datetime.datetime.fromisoformat(item["createdAt"].replace("Z", "+00:00"))
            if item["event"] == "workflow_dispatch" and item["headSha"] == head and created >= started:
                say("started release build, run " + str(item["databaseId"]))
                run(["gh", "run", "watch", str(item["databaseId"]), "--exit-status"], check=False, interactive=True)
                done = [x for x in gh_json(["run", "list", "--workflow", RELEASE_WORKFLOW, "--branch", WORK_BRANCH, "--limit", "10", "--json", fields])
                        if x["databaseId"] == item["databaseId"]][0]
                if done["conclusion"] != "success":
                    raise Abort("the release build did not succeed (" + str(done["conclusion"]) + "); see the run in GitHub Actions")
                return done
    raise Abort("the release build did not show up; check GitHub Actions")


def next_candidate_tag(version):
    numbers = [int(match.group(1)) for tag in git("tag", "-l", "v" + version + "-rc.*").stdout.split()
               for match in [re.fullmatch(r"v" + re.escape(version) + r"-rc\.(\d+)", tag)] if match]
    return "v" + version + "-rc." + str(max(numbers, default=0) + 1)


def command_candidate(arguments):
    global DRY_RUN
    DRY_RUN = arguments.dry_run
    start_log("candidate")
    version = arguments.version
    parse_version(version)
    head = preflight()
    local = local_versions()
    stable = latest_stable_tag()
    if stable and parse_version(version) <= parse_version(stable.lstrip("v")):
        raise Abort("release number " + version + " is not higher than the latest release " + stable)
    tag = next_candidate_tag(version)
    if git("rev-parse", "-q", "--verify", "refs/tags/" + tag, check=False).stdout.strip():
        raise Abort("tag " + tag + " already exists")

    # What changed since the last stable release decides where each package comes from.
    released = release_versions(stable) if stable else {}
    plan = {}
    for key, package_id, _ in PACKAGES:
        new, old = local[key], released.get(package_id)
        if old is None:
            plan[key] = "new"
        elif parse_version(new) == parse_version(old):
            plan[key] = "reuse"
        elif parse_version(new) > parse_version(old):
            plan[key] = "build"
        else:
            raise Abort(package_id + " " + new + " is lower than the released " + old)
    if all(action == "reuse" for action in plan.values()):
        raise Abort("no package changed since " + str(stable) + ": nothing to release")

    run_info = find_release_run(head, arguments.run)
    if run_info is None:
        run_info = trigger_release_run(head)
        if run_info is None:
            say("dry run ends here: it would now wait for the release build and go on from its artifact")
            return 0

    out = Path(arguments.out or Path.home() / "Downloads" / ("oiti-release-" + tag))
    if out.exists():
        raise Abort(str(out) + " already exists: remove it or choose another folder with --out")
    scratch = Path(tempfile.mkdtemp(prefix="oitui-release-"))
    try:
        ci = scratch / "ci"
        run(["gh", "run", "download", str(run_info["databaseId"]), "-D", str(ci)])
        built = {path.name: path for path in ci.rglob("*.deb")}
        ci_manifests = list(ci.rglob("SHA256SUMS"))
        if ci_manifests:
            listed = parse_manifest(ci_manifests[0].read_bytes())
            for name, path in built.items():
                if listed.get(name) != sha256_file(path):
                    raise Abort("the downloaded " + name + " does not match the build's own SHA256SUMS")

        previous = scratch / "previous"
        if "reuse" in plan.values():
            run(["gh", "release", "download", stable, "-D", str(previous)])
        previous_sums = parse_manifest((previous / "SHA256SUMS").read_bytes()) if (previous / "SHA256SUMS").exists() else {}

        out.mkdir(parents=True)
        lines = []
        for key, package_id, _ in PACKAGES:
            name = deb_name(package_id, local[key])
            if plan[key] == "reuse":
                source, where = previous / name, "unchanged, the byte-identical file of " + stable
                if not source.exists():
                    raise Abort(stable + " has no " + name)
                if name in previous_sums and previous_sums[name] != sha256_file(source):
                    raise Abort(name + " from " + stable + " does not match that release's SHA256SUMS")
            else:
                source, where = built.get(name), "new, built by run " + str(run_info["databaseId"])
                if source is None:
                    raise Abort("the build has no " + name + " (found: " + ", ".join(sorted(built)) + ")")
            if "+debug" in name or "~" in name:
                raise Abort(name + " has `+debug` or `~` in its name")
            shutil.copy2(source, out / name)
            lines.append((name, sha256_file(out / name), where))
        manifest = "".join(digest + "  " + name + "\n" for name, digest, _ in sorted(lines))
        (out / "SHA256SUMS").write_text(manifest)
    finally:
        shutil.rmtree(scratch, ignore_errors=True)

    say("")
    say("Release candidate " + tag + " (OITUI " + version + "), commit " + head[:7])
    for name, digest, where in lines:
        say("  " + name + "\n      " + digest + "\n      " + where)
    say("files are in " + str(out))
    say("")
    key = Path(os.environ.get("OITUI_SIGNING_KEY") or arguments.key or "~/oitui-signing/oitui-release-primary.key").expanduser()
    if DRY_RUN:
        say("[dry-run] would sign SHA256SUMS with " + str(key) + " and publish " + tag + " as a pre-release")
        return 0
    confirm("Sign this SHA256SUMS with " + str(key) + " (openssl will ask for the passphrase)?")
    signature = out / "SHA256SUMS.sig"
    run(["openssl", "pkeyutl", "-sign", "-rawin", "-inkey", str(key), "-in", str(out / "SHA256SUMS"), "-out", str(signature)],
        interactive=True)
    if not signature.exists() or signature.stat().st_size != 64:
        raise Abort("signing did not produce a 64-byte SHA256SUMS.sig")
    label = matching_trusted_key(out / "SHA256SUMS", signature)
    if label is None:
        signature.unlink()
        raise Abort("the signature is not valid for any key built into the helper: this is not the key Tellus trusts; nothing was published")
    say("ok   signed; the " + label + " key built into the helper accepts it")

    confirm("Tag " + tag + " at " + head[:7] + ", push the tag and publish the pre-release?")
    notes = ("Test build for OITUI " + version + ". Not for general use. Install it from Tellus: About > Check for Updates > menu > "
             "Include Pre-releases.\n\n" + "\n".join("- " + name + (" (unchanged: the file of " + stable + ")" if "unchanged" in where else "")
                                                     for name, _, where in lines))
    git("tag", "-a", tag, "-m", "OITUI " + version + " release candidate", mutating=True)
    git("push", "origin", tag, mutating=True)
    files = [str(out / name) for name in sorted(path.name for path in out.iterdir())]
    run(["gh", "release", "create", tag, "--verify-tag", "--prerelease", "--title", "OITUI " + version + " release candidate " + tag.split("-rc.")[1],
         "--notes", notes] + files, mutating=True)
    say("published " + tag + ". Pushing a tag also starts a release build of the same sources; ignore its artifact (it is not the tested one).")
    say("checking what GitHub now serves ...")
    with tempfile.TemporaryDirectory() as check:
        run(["gh", "release", "download", tag, "-D", check])
        problems, _ = check_release_folder(check)
    for problem in problems:
        say("FAIL " + problem)
    if problems:
        return 1
    say("")
    say("Next: test " + tag + " on the phone (COMMANDS.md section 44, steps 5 to 8), then answer the readiness questions.")
    return 0


# ---------------------------------------------------------------- main

def main(argv=None):
    parser = argparse.ArgumentParser(prog="oitui-release", description="OITUI release helper")
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("status", help="read-only overview")
    verify = sub.add_parser("verify", help="check a release's files and signature")
    verify.add_argument("target", help="a release tag, or a folder with the release files")
    candidate = sub.add_parser("candidate", help="build, sign and publish a release candidate")
    candidate.add_argument("version", help="the OITUI release number, e.g. 0.4.2")
    candidate.add_argument("--dry-run", action="store_true", help="print what would change instead of changing it")
    candidate.add_argument("--run", help="use this release-workflow run id instead of looking for or starting one")
    candidate.add_argument("--out", help="folder for the release files (default ~/Downloads/oiti-release-<tag>)")
    candidate.add_argument("--key", help="the encrypted signing key (default ~/oitui-signing/oitui-release-primary.key)")
    arguments = parser.parse_args(argv)
    try:
        handler = {"status": command_status, "verify": command_verify, "candidate": command_candidate}[arguments.command]
        return handler(arguments)
    except Abort as problem:
        say("STOPPED: " + str(problem))
        log("STOPPED: " + str(problem))
        return 1
    except KeyboardInterrupt:
        say("\nStopped.")
